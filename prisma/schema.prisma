generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ANALYST
  REVIEWER
  ADMIN
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ComplianceFlag {
  PASS
  REVIEW
  FAIL
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ANALYST)
  createdAt DateTime @default(now())

  createdAssessments  Assessment[] @relation("CreatedBy")
  reviewedAssessments Assessment[] @relation("ReviewedBy")
  auditLogs           AuditLog[]

  // NextAuth session models
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Assessment {
  id            String           @id @default(cuid())
  tokenName     String
  ticker        String?
  status        AssessmentStatus @default(DRAFT)
  overallScore  Float?
  flag          ComplianceFlag?
  reviewerNotes String?

  // Opt-in only, defaults to private. Set exclusively via the /registry
  // toggle route (REVIEWER/ADMIN, APPROVED assessments only) — see
  // src/app/api/assessments/[id]/registry/route.ts. When true, the token's
  // name/ticker/flag/date (nothing else — no score, notes, analyst, or
  // whitepaper data) becomes visible to unauthenticated visitors via the
  // public "already assessed?" search, so an analyst never accidentally
  // exposes a confidential client engagement just by finishing a review.
  listedPublicly Boolean @default(false)

  // AI layer
  aiStatus      String           @default("NONE")   // NONE | PENDING | COMPLETED | FAILED
  aiNarrative   String?          @db.Text
  aiError       String?          @db.Text
  aiSourceUrls  Json             @default("[]")

  // Whitepaper metadata — the actual PDF bytes live in AssessmentPdf, kept out
  // of this model so routes that JSON-serialize an Assessment can never
  // accidentally leak the raw file (AssessmentPdf is only ever explicitly
  // joined by the analyze route, which needs the bytes).
  pdfName      String?                              // original filename
  pdfSourceUrl String?                              // set only if ingested via URL fetch, not direct upload
  pdf          AssessmentPdf?

  createdById  String
  createdBy    User   @relation("CreatedBy", fields: [createdById], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ReviewedBy", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections  AssessmentSection[]
  auditLogs AuditLog[]

  @@index([tokenName])
  @@index([ticker])
  @@index([listedPublicly, status])
}

model AssessmentPdf {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  data      Bytes                          // raw PDF bytes
  createdAt DateTime @default(now())
}

model AssessmentSection {
  id           String    @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  sectionKey   String
  sectionName  String
  sectionScore Float?
  data         Json      @default("{}")
  completedAt  DateTime?

  // AI layer — per-field suggestions, never used by scoring engine
  aiData       Json      @default("{}")

  fields AssessmentField[]

  @@unique([assessmentId, sectionKey])
}

model AssessmentField {
  id         String            @id @default(cuid())
  sectionId  String
  section    AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  fieldKey   String
  fieldValue String
  score      Float?
  notes      String?

  @@unique([sectionId, fieldKey])
}

model AuditLog {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  userId    String
  user      User   @relation(fields: [userId], references: [id])

  action    String
  metadata  Json?
  timestamp DateTime @default(now())
}

// Captured from the public registry's "request an assessment" form — no
// account, no auth. Standalone (no FK to Assessment/User) since the token
// being asked about may not have any assessment yet. Viewed only via the
// ADMIN-only /leads page; nothing here is ever exposed publicly.
model LeadRequest {
  id        String   @id @default(cuid())
  tokenName String?
  email     String
  phone     String
  createdAt DateTime @default(now())
}
